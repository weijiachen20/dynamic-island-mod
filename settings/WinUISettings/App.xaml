<Application
    x:Class="DynamicIslandSettings.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <controls:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FF14161C" />
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FF1E222B" />
            <SolidColorBrush x:Key="HeaderBrush" Color="#FF6FB1FF" />
            <SolidColorBrush x:Key="LabelBrush" Color="#FFE6E8EE" />

            <Style x:Key="CardStyle" TargetType="StackPanel">
                <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
                <Setter Property="Padding" Value="14" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="BorderBrush" Value="#33FFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style x:Key="HeaderStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource HeaderBrush}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,2" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
